MAINNET_RPC=
MAINNET_DEPLOYER_NAME=

SEPOLIA_RPC=
SEPOLIA_DEPLOYER_NAME=

ARBITRUM_RPC=
ARBITRUM_DEPLOYER_NAME=

ETHERSCAN_API_KEY=

# Optional: defaults to broadcaster when unset
PROTOCOL_OWNER=

# Optional: override Sepolia default from pacto-squad-sponsor
PACTO_7702_ACCOUNT=

# Required for migrate:policy:v4:* and update:registry:*; optional on greenfield deploy (zero skips registerTarget)
# Sepolia Oct 2026 stack.json pins:
NAVE_PIRATA_FACTORY=0x97d2dbA09FCA62f3E634d850aB7d8fd7AdC7d9E4
SQUAD_SPONSOR_FACTORY=0x280755769367DDD108020eEF353A6dF0f8355f36

# Optional: NostrClaimLink library address if missing from full-system.json / broadcast
NOSTR_CLAIM_LINK=

# UpdateProtocolRegistry: next-generation paymaster (immutables become the new address book)
PAYMASTER=
# Optional: override derived EIP-7702 enabled flag (true when ALLOWED_7702_IMPLEMENTATION is non-zero)
EIP7702_ENABLED=

# FundPaymasterOps knobs (defaults: 0.1 ETH deposit, 0.1 ETH stake, 172800 sec delay)
PAYMASTER_EP_DEPOSIT_WEI=
PAYMASTER_STAKE_WEI=
PAYMASTER_UNSTAKE_DELAY_SEC=

# FundPoolOps knobs (defaults: 0.1 ETH each; 0 skips that pool)
GLOBAL_POOL_DEPOSIT_WEI=
BOOTSTRAP_POOL_DEPOSIT_WEI=
